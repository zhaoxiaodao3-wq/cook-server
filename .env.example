# 数据库地址（PostgreSQL）
# 本地开发（py run.py 默认读取 DATABASE_URL）
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cookbook

# ---------- 数据库同步（scripts/sync_db.py）----------
# 总开关：false=禁止同步，true=允许 schema/data 同步命令
DB_SYNC_ENABLED=false

# 本地库（留空则使用上面的 DATABASE_URL）
LOCAL_DATABASE_URL=

# 远程库 Supabase Direct 连接（端口 5432，用于同步；不要用 pooler 6543）
# 从 Supabase Dashboard → Connect → Direct connection 复制，前缀改为 postgresql+psycopg://
REMOTE_DATABASE_URL=postgresql+psycopg://postgres.uqiwkxzjlwlcrvwktcfa:你的密码@db.uqiwkxzjlwlcrvwktcfa.supabase.co:5432/postgres

# Supabase 生产环境（Render 环境变量用 Transaction pooler 端口 6543，与 REMOTE_DATABASE_URL 不同）
# DATABASE_URL=postgresql+psycopg://postgres.uqiwkxzjlwlcrvwktcfa:[密码]@aws-0-[区域].pooler.supabase.com:6543/postgres

# JWT 密钥（生产环境请换成随机字符串）
SECRET_KEY=change-me-to-a-random-string

# JWT 签名算法
JWT_ALGORITHM=HS256

# JWT 过期时间（分钟），默认 30 天
JWT_EXPIRE_MINUTES=43200

# 微信小程序 AppID（开发阶段留空使用模拟登录）
WECHAT_APP_ID=

# 微信小程序 AppSecret（开发阶段留空使用模拟登录）
WECHAT_APP_SECRET=
