# 数据库地址（PostgreSQL）
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cookbook

# JWT 密钥（生产环境请换成随机字符串）
SECRET_KEY=change-me-to-a-random-string

# JWT 签名算法
JWT_ALGORITHM=HS256

# JWT 过期时间（分钟），默认 30 天
JWT_EXPIRE_MINUTES=43200

# 微信小程序 AppID（开发阶段留空使用模拟登录）
WECHAT_APP_ID=

# 微信小程序 AppSecret（开发阶段留空使用模拟登录）
WECHAT_APP_SECRET=
